# ============================================================
# Social Local — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# PostgreSQL password (default: sociallocal)
POSTGRES_PASSWORD=sociallocal

# Facebook App credentials (required for OAuth login)
# Create an app at https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# The public URL of this deployment (used for OAuth callbacks and upload URLs)
# For local Docker Desktop: use http://localhost
APP_URL=http://localhost:8080

# The public base URL for file uploads (served via nginx at /api/uploads/)
PUBLIC_URL=http://localhost:8080

# Port for the frontend nginx container (default: 8080)
# Change this if 8080 is already in use on your machine
PORT=8080

# Optional: Hugging Face API key for faster AI image generation
# Without it, falls back to pollinations.ai (free, no key needed)
HUGGING_FACE_API_KEY=

# DATABASE_URL is automatically wired from the docker-compose postgres service.
# Only needed if you're running outside Docker:
# DATABASE_URL=postgresql://sociallocal:sociallocal@localhost:5432/sociallocal
